{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": false,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/styles/globals.css",
    "baseColor": "slate",
    "cssVariables": true
  },
  "aliases": {
    "components": "src/components",
    "utils": "src/utils"
  },
  "registries": {
    "reactbits-starter": {
      "url": "https://pro.reactbits.dev/r",
      "headers": {
        "Authorization": "Bearer $REACTBITS_LICENSE_KEY"
      }
    }
  }
}
